# ============================================================
# Launched - Template de configuration (copier en .env)
# ============================================================

# PostgreSQL
POSTGRES_USER=launched
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=launched_db

# Discord OAuth (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=https://launched.infuseting.fr/api/auth/discord/callback
DISCORD_ADMIN_IDS=your_discord_id_here
DISCORD_GUILD_ID=1496947207847411965
NEXT_PUBLIC_DISCORD_INVITE_URL=https://discord.gg/kfzyScBSqS

# JWT (générer avec : openssl rand -base64 64)
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# SFTPGo
SFTPGO_ADMIN_USER=admin
SFTPGO_ADMIN_PASSWORD=CHANGE_ME_MAX_64_CHARS
SFTPGO_SFTP_HOST=launched.infuseting.fr
SFTPGO_SFTP_PORT=2022

# App
NEXT_PUBLIC_APP_URL=https://launched.infuseting.fr
